{
  "name": "kapa-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:deploy": "node --experimental-strip-types scripts/build-deploy.mjs",
    "release": "npm run build:deploy && node scripts/package-release.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "env:local": "node scripts/local-env.mjs",
    "db:start": "node scripts/prepare-local-db.mjs && sh scripts/supabase.sh start -x studio,imgproxy,realtime,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "sh scripts/supabase.sh stop",
    "db:test": "sh scripts/supabase.sh test db",
    "db:types": "sh scripts/generate-types.sh",
    "db:installer": "node scripts/build-installer.mjs",
    "db:test:installer": "npm run db:installer && python3 scripts/test-installer.py"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.90.0",
    "@tailwindcss/vite": "^4.1.0",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "fflate": "^0.8.3",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
